rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function membro() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function papel() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel; }
    function admin() { return membro() && papel() == 'admin'; }
    function clinico() { return membro() && papel() in ['admin', 'clinico']; }

    // Perfis: cada pessoa lê o próprio; só a administração cria ou altera.
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || admin());
      allow write: if admin();
    }
    // Beneficiários: a recepção cadastra e arquiva; só a administração exclui.
    match /beneficiarios/{id} {
      allow read, create, update: if membro();
      allow delete: if admin();
    }
    match /profissionais/{id} { allow read, write: if membro(); }
    match /agendamentos/{id}  { allow read, write: if membro(); }
    match /config/{id} {
      allow read: if membro();
      allow write: if admin();
    }
    // Prontuário: só equipe clínica lê. Cada apontamento é criado pelo próprio
    // autor, com horário do servidor, e não pode ser alterado nem apagado.
    // Auditoria: quem registra é o próprio usuário, com horário do servidor. Ninguém altera ou apaga.
    match /auditoria/{id} {
      allow read: if admin();
      allow create: if membro()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'papel', 'acao', 'colecao', 'docId', 'campos', 'valores', 'quando'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.papel == papel()
        && request.resource.data.quando == request.time
        && request.resource.data.acao in ['criar', 'alterar', 'excluir'];
      allow update, delete: if false;
    }
    match /prontuarios/{id} {
      allow read: if clinico();
      allow create: if clinico()
        && request.resource.data.keys().hasOnly(['beneficiarioId', 'profissionalId', 'agendamentoId', 'quando', 'texto', 'autorId'])
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.quando == request.time
        && request.resource.data.beneficiarioId is string
        && request.resource.data.profissionalId is string
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 5000;
      allow update, delete: if false;
    }
  }
}
